# Local cargo state; keep shared rustflags (Boot/TTFF RELRO) in repo.
.cargo/*
!.cargo/config.toml
target/
**/*.rs.bk

# Local agent / session / ops scratch (do not commit)
.omo/
.whycode/
local/
# Unexpanded editor env vars sometimes land as a literal directory name
$JCODE_SCRATCH_DIR/

# Python bytecode from scripts/ (never commit)
__pycache__/
*.pyc

# TypeScript SDK
node_modules/
sdk/typescript/dist/

# Editor / OS junk
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
.env
.env.*
!.env.example

# Claude/local agent worktrees
.claude/
