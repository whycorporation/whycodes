# Local cargo state; keep shared rustflags (Boot/TTFF RELRO) in repo.
.cargo/*
!.cargo/config.toml
target/
**/*.rs.bk

# Local agent/session scratch (do not commit)
.omo/
# Machine-local external-directory grants for the agent (absolute paths)
.whycode/external_dirs_allowed
# Swarm worker worktrees (created/removed per run; never commit)
.whycode/swarm/
# Machine-local notes / ops scrap (self-hosted runner, secrets, host facts)
local/
.whycode/todos.json

# Python bytecode from scripts/ (never commit)
__pycache__/
*.pyc
