# Local cargo state; keep shared rustflags (Boot/TTFF RELRO) and the
# cargo-audit exception policy in repo.
.cargo/*
!.cargo/config.toml
!.cargo/audit.toml
target/
**/*.rs.bk

# Local agent / session / ops scratch (do not commit)
.omo/
.whycode/
.whycodes/
.cline/
local/
# Unexpanded editor env vars sometimes land as a literal directory name
$JCODE_SCRATCH_DIR/

# Python bytecode from scripts/ (never commit)
__pycache__/
*.pyc

# TypeScript SDK
node_modules/
sdk/typescript/dist/

# Editor / OS junk
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
.env
.env.*
!.env.example

# Claude/local agent worktrees
.claude/
.tmp-landing-github/

# Credentials and coverage dumps (never commit)
*.pem
*.p12
*.pfx
id_rsa
id_dsa
id_ecdsa
id_ed25519
auth.json
lcov.info
*.profraw
*.profdata

# Local sqlite fixtures and leftover llvm-cov dirs (never commit)
*.db
.cov-*/
.tmp-cov-*/
.agents/
