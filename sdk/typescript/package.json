{
  "name": "@whycorporation/whycodes-sdk",
  "version": "0.2.0",
  "description": "Thin TypeScript client for whycodes serve (protocol v1)",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/whycorporation/whycodes/tree/main/sdk/typescript",
  "bugs": {
    "url": "https://github.com/whycorporation/whycodes/issues"
  },
  "keywords": [
    "whycodes",
    "sdk",
    "agent",
    "sse"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whycorporation/whycodes.git",
    "directory": "sdk/typescript"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test test/*.test.mjs",
    "prepublishOnly": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^7.0.2"
  }
}
